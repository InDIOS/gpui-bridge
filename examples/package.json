{
  "name": "gpui-bridge-examples",
  "private": true,
  "type": "module",
  "description": "Runnable examples: they consume the packages exactly like a published install",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.react.json --noEmit",
    "build:react": "tsc -p tsconfig.react.json"
  },
  "dependencies": {
    "gpui-bridge": "workspace:*",
    "gpui-bridge-react": "workspace:*",
    "react": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "19.3.0",
    "typescript": "7.0.2"
  }
}
